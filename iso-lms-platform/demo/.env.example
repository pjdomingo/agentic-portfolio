# Copy to .env.local and fill in to run the demo against the real Claude API.
#
# Without a key, the app runs in MOCK mode: the same UI flow using canned
# course content with simulated streaming. Great for offline pitching.
# With a key, uploading a document really calls Claude and generates a course.

# Your Anthropic API key (https://console.anthropic.com/ -> API Keys)
ANTHROPIC_API_KEY=

# Model used for generation. Defaults to claude-sonnet-5 (per the plan's
# tech-stack doc). You can drop to claude-haiku-4-5 for cheaper/faster demos.
GENERATION_MODEL=claude-sonnet-5

# Force mock mode even if a key is set (useful for a guaranteed-offline pitch):
#   DEMO_MODE=mock
DEMO_MODE=
